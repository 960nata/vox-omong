{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOX·AI Studio",
  "version": "0.1.0",
  "identifier": "dev.hadinata.vox.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run desktop:next && npm run desktop:prepare",
    "frontendDist": "../.vox-desktop/splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VOX·AI Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.vox-desktop/server": "server",
      "../electron/launch-server.cjs": "launch-server.cjs"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
