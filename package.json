{
  "name": "vox-omong",
  "version": "0.1.0",
  "private": true,
  "description": "Asisten AI yang tinggal disuruh: ngomong atau ketik, hasilnya jadi website, slide, dokumen, dan video.",
  "license": "MIT",
  "author": "Dicky Hadinata (https://hadinata.dev)",
  "keywords": [
    "ai-assistant",
    "voice-assistant",
    "nextjs",
    "agent",
    "indonesia"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/start-local-tools.mjs",
    "dev": "next dev -H 127.0.0.1",
    "dev:lan": "VOX_ALLOW_LAN=1 next dev -H 0.0.0.0",
    "mobile": "node scripts/mobile.mjs",
    "build": "next build",
    "prestart": "node scripts/start-local-tools.mjs",
    "start": "next start -H 127.0.0.1",
    "freellmapi:test": "node scripts/test-native-freellm.cjs",
    "freellmapi:check": "node scripts/test-freellmapi-integration.cjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "wa": "node scripts/wa-bot.mjs",
    "skills:list": "node scripts/skill-engine.mjs list",
    "skills:install": "node scripts/skill-engine.mjs install-all",
    "skills:info": "node scripts/skill-engine.mjs info"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "animejs": "^4.5.0",
    "jszip": "^3.10.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.16.0",
    "msedge-tts": "^2.1.1",
    "next": "16.4.5",
    "pino": "^10.4.0",
    "playwright-core": "^1.65.0",
    "pptxgenjs": "^4.0.1",
    "qrcode-terminal": "^0.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "magic-string": "0.30.17"
  }
}
