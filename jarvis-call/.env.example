# ===== Gemini =====
GOOGLE_API_KEY=
# Kosongkan = pakai model default Pipecat. Suara: Puck, Charon, Kore, Fenrir, Aoede
GEMINI_MODEL=
GEMINI_VOICE=Puck

# ===== WhatsApp Cloud API (Meta Developer → WhatsApp → API Setup) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bebas, asal sama dengan yang kamu isi di Meta → Webhooks → Verify token
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=ganti-dengan-string-acak
# App settings → Basic → App secret (buat cek tanda tangan webhook). Sangat disarankan.
WHATSAPP_APP_SECRET=

# Nomor yang boleh nelpon (format 62..., tanpa + dan spasi). Pisah koma kalau lebih dari satu.
OWNER_NUMBERS=6281234567890

# Kalau bot chat WA kamu (Next.js) juga pakai webhook app Meta yang sama,
# isi URL webhook chat-nya di sini. Event chat bakal diteruskan ke sana.
FORWARD_WEBHOOK_URL=

# ===== Jarvis (Next.js) =====
JARVIS_API_URL=http://localhost:3000
# Harus sama dengan JARVIS_API_SECRET di .env Next.js
JARVIS_API_SECRET=ganti-dengan-string-acak-panjang
# 1 = tugas disimulasikan (buat ngetes telpon sebelum nyambung ke Next.js)
JARVIS_MOCK=1
POLL_INTERVAL_SECS=5

ASSISTANT_NAME=Jarvis
OWNER_NAME=Bos
